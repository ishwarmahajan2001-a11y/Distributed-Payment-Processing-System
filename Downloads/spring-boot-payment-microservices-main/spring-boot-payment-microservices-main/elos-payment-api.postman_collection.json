							"const secret = \"my-super-secret-key-for-elos\"; ",
							"",
							"const signature = CryptoJS.HmacSHA256(requestBody, secret).toString(CryptoJS.enc.Base64);",
							"",
							"pm.request.headers.add({",
							"    key: \"X-Client-Signature\",",
							"    value: signature",
							"});"
						],
