		{
			"name": "[Success] Initiate New Payment",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"const requestBody = pm.request.body.raw;\r",
							"const secret = \"my-super-secret-key-for-elos\"; \r",
							"\r",
							"const signature = CryptoJS.HmacSHA256(requestBody, secret).toString(CryptoJS.enc.Base64);\r",
							"\r",
							"pm.request.headers.add({\r",
							"    key: \"X-Client-Signature\",\r",
							"    value: signature\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"// This script runs *after* a successful response is received.\r",
							"try {\r",
							"    const response = pm.response.json();\r",
							"    // This navigates the complex response string to find the ID.\r",
							"    const providerResponse = JSON.parse(response[\"Downstream response: [Payment processing initiated. Provider response: \"].slice(0, -1));\r",
							"    const transactionId = providerResponse.transactionReferenceId;\r",
							"\r",
							"    if (transactionId) {\r",
							"        pm.collectionVariables.set(\"transactionId\", transactionId);\r",
							"        console.log(\"Saved transactionId for next step:\", transactionId);\r",
							"    }\r",
							"} catch (e) {\r",
							"    console.log(\"Could not find transactionId in the response.\");\r",
							"}"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n  \"merchantTransactionId\": \"elos-dk-{{$randomInt}}\",\r\n  \"user\": {\r\n    \"email\": \"customer@elos.dk\"\r\n  },\r\n  \"amount\": 99.99,\r\n  \"currency\": \"DKK\"\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "http://localhost:8081/api/validate/payment",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8081",
					"path": [
						"api",
						"validate",
						"payment"
					]
				}
			},
			"response": []
		},
